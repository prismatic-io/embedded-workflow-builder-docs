{
  "name": "embedded-workflow-builder-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "check": "npm run check-spelling && npm run check-markdown && npm run check-js && npm run lint",
    "check-js": "biome format",
    "check-markdown": "prettier --log-level warn --check \"docs/**/*.md\" && eslint --config eslint.markdown.config.mjs",
    "check-spelling": "cspell --config cspell.jsonc",
    "format": "npm run format-markdown && npm run format-js",
    "format-js": "biome format --write",
    "format-markdown": "prettier --log-level warn --write \"docs/**/*.md\" && eslint --config eslint.markdown.config.mjs --fix",
    "lint": "biome lint",
    "generate-branded-markdown": "docusaurus generate-branded-markdown",
    "generate-public-connector-docs": "docusaurus generate-connector-docs --public-connectors",
    "postgenerate-public-connector-docs": "npm run format-markdown",
    "generate-public-connector-docs-from-manifest": "docusaurus generate-connector-docs --public-connectors --from-manifest",
    "postgenerate-public-connector-docs-from-manifest": "npm run format-markdown",
    "generate-private-connector-docs": "docusaurus generate-connector-docs --private-connector",
    "postgenerate-private-connector-docs": "npm run format-markdown",
    "resize-screenshots": "docusaurus resize-screenshots",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "lodash.merge": "^4.6.2",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@docusaurus/faster": "^3.10.2",
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@eslint/markdown": "^8.0.3",
    "cli-progress": "^3.12.0",
    "cspell": "^10.0.1",
    "eslint": "^10.6.0",
    "front-matter-markdown": "^0.4.5",
    "graffle": "^8.0.0-next.164",
    "graphql": "^16.14.2",
    "handlebars": "^4.7.9",
    "js-yaml": "^5.2.2",
    "prettier": "^3.9.4",
    "rimraf": "^6.1.3",
    "sharp": "^0.35.3",
    "typescript": "~6.0.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  },
  "overrides": {
    "@docusaurus/bundler": {
      "copy-webpack-plugin": "14.0.0",
      "css-minimizer-webpack-plugin": "8.0.0"
    },
    "webpack-dev-server": {
      "uuid": "14.0.1"
    }
  }
}
